# Copy this file to ".env" and fill in your values. NEVER commit the real .env.
# The refresh token IS your Ring account credential — keep it only on this machine.

RING_REFRESH_TOKEN=paste-the-token-from-npm-run-get-token-here
# Optional: part of your camera's name (as shown in the Ring app). Blank = first camera.
RING_CAMERA_NAME=Front
# Port the bridge listens on
PORT=8123
# The website allowed to embed the stream (your calendar's origin)
ALLOW_ORIGIN=https://venu-madhav-mahadevu.github.io
# Stop the stream after this many ms with no viewers
IDLE_STOP_MS=60000
